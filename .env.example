# Ligature — optional server-side provider keys.
# Every key is optional; the Settings dialog in the app can hold them in the browser instead.
# Values here are used only when the matching field in Settings is empty.

# Pollinations (https://enter.pollinations.ai) — free key adds weekly Pollen for text/video models.
POLLINATIONS_API_KEY=

# Cloudflare Workers AI (https://dash.cloudflare.com) — free 10,000 neurons/day.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google Gemini (https://aistudio.google.com/apikey) — free tier.
GEMINI_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens) — optional, raises free ZeroGPU quota on Spaces.
HF_TOKEN=

# Any OpenAI-compatible endpoint (Ollama, LM Studio, Groq, OpenRouter…).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Claude Agent SDK: leave unset to use your local Claude Code login (Pro/Max).
# ANTHROPIC_API_KEY=
